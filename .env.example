# Copy this file to .env and fill in what you have. Everything is optional;
# panels without a key show "offline" instead of fake data.

# Live AIS ship positions — free key at https://aisstream.io (sign in with GitHub, "API Keys")
AISSTREAM_API_KEY=

# AI desk analyst (Claude). Get a key at https://platform.claude.com
ANTHROPIC_API_KEY=
ANALYST_INTERVAL_MIN=15

# X / Twitter recent search (needs a paid X API plan). Bearer token from developer.x.com
X_BEARER_TOKEN=

# Bluesky search works best with an app password (Settings > App passwords)
BSKY_HANDLE=
BSKY_APP_PASSWORD=

# Public Telegram channels to watch (comma-separated usernames, no @), e.g. channelA,channelB
TELEGRAM_CHANNELS=

# Phone alerts (optional). Use either or both.
# ntfy: install the ntfy app, subscribe to an unguessable topic, put it here.
NTFY_TOPIC=
# Telegram: create a bot with @BotFather, message it once, read your chat id from /getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# critical (default) or warning
NOTIFY_MIN_SEVERITY=critical

PORT=8787
